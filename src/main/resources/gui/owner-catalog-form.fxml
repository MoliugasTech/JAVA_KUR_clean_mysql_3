<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javakur.fxControllers.OwnerCatalogFormController">
    <top>
        <VBox spacing="5" styleClass="toolbar-panel">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>
            <Label text="Restoranai ir meniu" styleClass="title"/>
            <Label text="Kurkite restoranus ir valdykite klientams matomus patiekalus."
                   styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.48">
            <items>
                <VBox spacing="10" styleClass="edit-panel">
                    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                    <HBox spacing="10">
                        <Label text="Mano restoranai" styleClass="section-title"
                               HBox.hgrow="ALWAYS"/>
                        <Button text="Naujas" onAction="#handleNewRestaurant"/>
                    </HBox>
                    <TableView fx:id="restaurantsTable" prefHeight="250">
                        <columns>
                            <TableColumn fx:id="restaurantIdColumn" text="ID" prefWidth="55"/>
                            <TableColumn fx:id="restaurantNameColumn" text="Pavadinimas" prefWidth="190"/>
                            <TableColumn fx:id="restaurantTypeColumn" text="Tipas" prefWidth="115"/>
                            <TableColumn fx:id="restaurantHoursColumn" text="Darbo laikas" prefWidth="130"/>
                        </columns>
                    </TableView>
                    <Separator/>
                    <Label fx:id="restaurantFormTitle" text="Naujas restoranas"
                           styleClass="section-title"/>
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Pavadinimas" styleClass="field-label"/>
                            <TextField fx:id="restaurantNameField"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Tipas" styleClass="field-label"/>
                            <ComboBox fx:id="restaurantTypeCombo" prefWidth="150"/>
                        </VBox>
                    </HBox>
                    <Label text="Aprašymas" styleClass="field-label"/>
                    <TextArea fx:id="restaurantDescriptionField" prefRowCount="2" wrapText="true"/>
                    <Label text="Adresas" styleClass="field-label"/>
                    <TextField fx:id="restaurantAddressField"/>
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Atidarymas (HH:mm)" styleClass="field-label"/>
                            <TextField fx:id="openingTimeField"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Uždarymas (HH:mm)" styleClass="field-label"/>
                            <TextField fx:id="closingTimeField"/>
                        </VBox>
                    </HBox>
                    <Button text="Išsaugoti restoraną" maxWidth="Infinity"
                            onAction="#handleSaveRestaurant"/>
                </VBox>
                <VBox spacing="10" styleClass="edit-panel">
                    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                    <HBox spacing="10">
                        <Label text="Pasirinkto restorano meniu" styleClass="section-title"
                               HBox.hgrow="ALWAYS"/>
                        <Button text="Naujas patiekalas" onAction="#handleNewMenuItem"/>
                    </HBox>
                    <TableView fx:id="menuTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="menuIdColumn" text="ID" prefWidth="55"/>
                            <TableColumn fx:id="menuNameColumn" text="Patiekalas" prefWidth="220"/>
                            <TableColumn fx:id="menuPriceColumn" text="Kaina, €" prefWidth="100"/>
                            <TableColumn fx:id="menuAvailabilityColumn" text="Būsena" prefWidth="110"/>
                        </columns>
                    </TableView>
                    <Separator/>
                    <Label fx:id="menuFormTitle" text="Naujas patiekalas"
                           styleClass="section-title"/>
                    <Label text="Pavadinimas" styleClass="field-label"/>
                    <TextField fx:id="menuNameField"/>
                    <Label text="Aprašymas" styleClass="field-label"/>
                    <TextArea fx:id="menuDescriptionField" prefRowCount="2" wrapText="true"/>
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Kaina, €" styleClass="field-label"/>
                            <TextField fx:id="menuPriceField" promptText="8.50"/>
                        </VBox>
                        <CheckBox fx:id="menuAvailableCheck" text="Parduodamas" selected="true"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="Išsaugoti patiekalą" maxWidth="Infinity"
                                HBox.hgrow="ALWAYS" onAction="#handleSaveMenuItem"/>
                        <Button text="Pašalinti" styleClass="danger-button"
                                onAction="#handleDeleteMenuItem"/>
                    </HBox>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox styleClass="toolbar-panel">
            <padding><Insets top="10" right="24" bottom="10" left="24"/></padding>
            <Label fx:id="statusLabel" text="Pasirinkite restoraną." styleClass="form-hint"/>
        </HBox>
    </bottom>
</BorderPane>
