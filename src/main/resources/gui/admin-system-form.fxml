<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javakur.fxControllers.AdminSystemFormController">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar-panel">
            <padding><Insets top="18" right="24" bottom="16" left="24"/></padding>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Administratoriaus sistemos centras" styleClass="title"/>
                <Label text="Visi užsakymai, restoranai, patiekalai, žinutės ir atsiliepimai."
                       styleClass="subtitle"/>
            </VBox>
            <Button text="Atnaujinti viską" onAction="#refreshData"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Užsakymai">
                    <content>
                        <VBox spacing="10" styleClass="content-panel">
                            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                            <HBox spacing="8">
                                <ComboBox fx:id="orderRestaurantFilter" promptText="Visi restoranai"
                                          prefWidth="220"/>
                                <ComboBox fx:id="orderStatusFilter" promptText="Visos būsenos"
                                          prefWidth="170"/>
                                <DatePicker fx:id="orderFromDate" promptText="Data nuo"/>
                                <DatePicker fx:id="orderToDate" promptText="Data iki"/>
                                <TextField fx:id="orderClientFilter" promptText="Klientas"
                                           HBox.hgrow="ALWAYS"/>
                                <Button text="Filtruoti" onAction="#refreshOrders"/>
                                <Button text="Išvalyti" styleClass="secondary-button-light"
                                        onAction="#clearOrderFilters"/>
                            </HBox>
                            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="orderIdColumn" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="orderStatusColumn" text="Būsena" prefWidth="135"/>
                                    <TableColumn fx:id="orderRestaurantColumn" text="Restoranas" prefWidth="190"/>
                                    <TableColumn fx:id="orderClientColumn" text="Klientas" prefWidth="130"/>
                                    <TableColumn fx:id="orderDriverColumn" text="Vairuotojas" prefWidth="130"/>
                                    <TableColumn fx:id="orderCreatedColumn" text="Sukurta" prefWidth="145"/>
                                    <TableColumn fx:id="orderTotalColumn" text="Suma, €" prefWidth="95"/>
                                </columns>
                            </TableView>
                            <Button text="Pašalinti užbaigtą / atšauktą užsakymą"
                                    styleClass="danger-button" onAction="#deleteSelectedOrder"/>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Restoranai ir patiekalai">
                    <content>
                        <SplitPane dividerPositions="0.62">
                            <items>
                                <VBox spacing="10" styleClass="edit-panel">
                                    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                                    <Label text="Restorano meniu" styleClass="section-title"/>
                                    <ComboBox fx:id="catalogRestaurantCombo" maxWidth="Infinity"
                                              promptText="Pasirinkite restoraną"/>
                                    <TableView fx:id="adminMenuTable" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="menuIdColumn" text="ID" prefWidth="60"/>
                                            <TableColumn fx:id="menuNameColumn" text="Patiekalas" prefWidth="260"/>
                                            <TableColumn fx:id="menuPriceColumn" text="Kaina, €" prefWidth="100"/>
                                            <TableColumn fx:id="menuAvailableColumn" text="Prieinamas" prefWidth="110"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                                <VBox spacing="10" styleClass="edit-panel">
                                    <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
                                    <HBox spacing="10">
                                        <Label fx:id="menuFormTitle" text="Naujas patiekalas"
                                               styleClass="section-title" HBox.hgrow="ALWAYS"/>
                                        <Button text="Naujas" onAction="#newMenuItem"/>
                                    </HBox>
                                    <Separator/>
                                    <Label text="Pavadinimas" styleClass="field-label"/>
                                    <TextField fx:id="menuNameField"/>
                                    <Label text="Aprašymas" styleClass="field-label"/>
                                    <TextArea fx:id="menuDescriptionField" prefRowCount="4"
                                              wrapText="true"/>
                                    <Label text="Kaina, €" styleClass="field-label"/>
                                    <TextField fx:id="menuPriceField" promptText="8.50"/>
                                    <CheckBox fx:id="menuAvailableCheck" text="Prieinamas klientams"
                                              selected="true"/>
                                    <Button text="Išsaugoti" maxWidth="Infinity"
                                            onAction="#saveMenuItem"/>
                                    <Button text="Pašalinti" maxWidth="Infinity"
                                            styleClass="danger-button" onAction="#deleteMenuItem"/>
                                </VBox>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
                <Tab text="Žinutės">
                    <content>
                        <VBox spacing="10" styleClass="content-panel">
                            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                            <TableView fx:id="messagesTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="messageIdColumn" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="messageOrderColumn" text="Užsakymas" prefWidth="100"/>
                                    <TableColumn fx:id="messageSenderColumn" text="Siuntėjas" prefWidth="150"/>
                                    <TableColumn fx:id="messageTimeColumn" text="Laikas" prefWidth="160"/>
                                    <TableColumn fx:id="messageContentColumn" text="Turinys" prefWidth="720"/>
                                </columns>
                            </TableView>
                            <Label text="Pasirinktos žinutės turinys" styleClass="field-label"/>
                            <TextArea fx:id="messageContentEditor" prefRowCount="3"
                                      wrapText="true"/>
                            <HBox spacing="10">
                                <Button text="Išsaugoti pakeitimą"
                                        onAction="#saveMessage"/>
                                <Button text="Pašalinti pasirinktą žinutę"
                                        styleClass="danger-button" onAction="#deleteMessage"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Atsiliepimai">
                    <content>
                        <VBox spacing="10" styleClass="content-panel">
                            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                            <TableView fx:id="reviewsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="reviewIdColumn" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="reviewOrderColumn" text="Užsakymas" prefWidth="100"/>
                                    <TableColumn fx:id="reviewAuthorColumn" text="Autorius" prefWidth="150"/>
                                    <TableColumn fx:id="reviewTypeColumn" text="Tipas" prefWidth="140"/>
                                    <TableColumn fx:id="reviewRatingColumn" text="Balas" prefWidth="80"/>
                                    <TableColumn fx:id="reviewCommentColumn" text="Komentaras" prefWidth="650"/>
                                </columns>
                            </TableView>
                            <Button text="Pašalinti pasirinktą atsiliepimą"
                                    styleClass="danger-button" onAction="#deleteReview"/>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
    <bottom>
        <HBox styleClass="toolbar-panel">
            <padding><Insets top="10" right="24" bottom="10" left="24"/></padding>
            <Label fx:id="statusLabel" text="Duomenys kraunami..." styleClass="form-hint"/>
        </HBox>
    </bottom>
</BorderPane>
