<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="132dp"
    android:padding="12dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/menuItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/forest"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/menuItemPrice"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/menuItemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/orange"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/menuItemDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/muted"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuItemName"/>

    <Button
        android:id="@+id/menuItemMinus"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/minus"
        android:textAllCaps="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuItemDescription"/>

    <TextView
        android:id="@+id/menuItemQuantity"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textColor="@color/forest"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/menuItemMinus"
        app:layout_constraintTop_toTopOf="@id/menuItemMinus"/>

    <Button
        android:id="@+id/menuItemPlus"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="@string/plus"
        android:textAllCaps="false"
        app:layout_constraintStart_toEndOf="@id/menuItemQuantity"
        app:layout_constraintTop_toTopOf="@id/menuItemMinus"/>
</androidx.constraintlayout.widget.ConstraintLayout>
