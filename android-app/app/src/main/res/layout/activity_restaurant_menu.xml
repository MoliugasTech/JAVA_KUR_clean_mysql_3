<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:padding="16dp">
    <Button android:id="@+id/menuBackButton" android:layout_width="wrap_content" android:layout_height="48dp"
        android:text="@string/back" android:textAllCaps="false"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/restaurantName" android:layout_width="0dp" android:layout_height="wrap_content"
        android:textColor="@color/forest" android:textSize="26sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/menuBackButton" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/restaurantDescription" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/muted"
        app:layout_constraintTop_toBottomOf="@id/restaurantName" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/restaurantDetails" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/forest"
        app:layout_constraintTop_toBottomOf="@id/restaurantDescription" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/menuTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="@string/menu" android:textColor="@color/forest"
        android:textSize="22sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/restaurantDetails" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ListView android:id="@+id/menuItemsList" android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone" android:dividerHeight="12dp"
        app:layout_constraintTop_toBottomOf="@id/menuTitle" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <ProgressBar android:id="@+id/menuProgress" android:layout_width="wrap_content" android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/menuTitle" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/menuMessage" android:layout_width="0dp" android:layout_height="wrap_content"
        android:gravity="center" android:visibility="gone" android:textColor="@color/muted"
        app:layout_constraintTop_toBottomOf="@id/menuTitle" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
